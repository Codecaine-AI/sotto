    "b-architecture-sotto-s-macos-client-han-1": {
      "id": "b-architecture-sotto-s-macos-client-han-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sotto's macOS client handles microphone capture, shortcuts, and cursor insertion. An independent HTTP server owns inference, shared settings, and history. Both processes use the same API whether they run on one machine or across the network."
        }
      ],
      "children": []
    },
