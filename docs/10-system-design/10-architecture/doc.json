        {
          "insert": ". "
        },
        {
          "insert": "SOTTO_CLIENT_DATA_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides either, and the dev runner selects "
        },
        {
          "insert": ".local/client",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stores shortcut/microphone settings; "
        },
        {
          "insert": "client.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stores endpoint/device identity. Tokens live in separate release/Dev Keychain services, scoped to the endpoint and client directory. "
        },
        {
          "insert": "SOTTO_SERVER_URL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides the saved endpoint for a run. Valid manual "
        },
        {
          "insert": "config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " edits are reloaded; invalid files leave the last good configuration active."
        }
      ],
      "children": []
    },
