    "b-architecture-text-22": {
      "id": "b-architecture-text-22",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "preferences.json\ngenerations/<UUID>/\n  metadata.json\n  transcript.txt\n  raw.txt\n  clean.txt\n  inference.wav\n  original.wav"
        }
      ],
      "children": []
