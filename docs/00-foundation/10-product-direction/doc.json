        }
      ],
      "children": []
    },
    "b-10-product-direction-the-archive-is-a-single-9": {
      "id": "b-10-product-direction-the-archive-is-a-single-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The archive is a single-writer file dataset. Cloud synchronization, multiwriter coordination, curated dataset releases, continuous Wispr import, and changing Sotto's 180-second live recording limit are not implemented. The existing Wispr installation and nightly WisprSync export are unchanged."
        }
      ],
      "children": []
    },
