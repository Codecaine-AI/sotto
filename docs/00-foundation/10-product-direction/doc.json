    "b-10-product-direction-the-product-captures-spe-1": {
      "id": "b-10-product-direction-the-product-captures-spe-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The product captures speech, preserves the original recognition, and produces cleaned text for insertion. Ford intends to stop using Wispr Flow and develop this fork as the replacement. The fork installs its app under the name Transcriber."
        }
      ],
      "children": []
    },
    "b-10-product-direction-accepted-decisions-2": {
      "id": "b-10-product-direction-accepted-decisions-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accepted Decisions"
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-permanent-archive-co-3": {
      "id": "b-10-product-direction-the-permanent-archive-co-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The permanent archive contains historical Wispr data and future Transcriber recordings, with raw and clean formats, every available source field, and attachments."
        }
      ],
      "children": []
    },
    "b-10-product-direction-archive-data-is-a-first-4": {
      "id": "b-10-product-direction-archive-data-is-a-first-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Archive data is a first-class dataset with its own manifest, source evidence, integrity reports, and Data page. Named curated collections were proposed during the audit but were not selected for this phase."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-archive-has-no-artif-5": {
      "id": "b-10-product-direction-the-archive-has-no-artif-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The archive has no artifact-size cap. It must keep oversized audio, unknown dates, malformed source IDs, and source versions rather than silently omit them."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-working-archive-stay-6": {
      "id": "b-10-product-direction-the-working-archive-stay-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The working archive stays local at "
        },
        {
          "insert": "/Users/Ford/Transcripts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Dropbox was intended as automatic backup. A home NAS is planned, but no backup destination, schedule, or retention policy has been configured."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-fork-lives-under-co-7": {
      "id": "b-10-product-direction-the-fork-lives-under-co-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork's GitHub repository is "
        },
        {
          "insert": "Codecaine-AI/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and its checkout is "
        },
        {
          "insert": "/Users/Ford/workspace/codecaine/utilities/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Preserve upstream attribution and keep personal data, model weights, and local runtime configuration out of Git."
        }
      ],
      "children": []
    },
    "naming-heading": {
      "id": "naming-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Naming"
        }
      ],
      "children": []
    },
    "naming-lead": {
      "id": "naming-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Three names are in use. Transcriber is the fork's installed app. V07 is upstream's project, modules, environment variable prefix, and development app. Sotto is the earlier upstream name, which the fork keeps in a fixed set of identifiers."
        }
      ],
      "children": []
    },
    "naming-identity": {
      "id": "naming-identity",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The installed app has a fixed identity: the name Transcriber and the bundle identifier "
        },
        {
          "insert": "ai.codecaine.transcriber",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". macOS permissions, the client settings directory, and the Keychain service follow the bundle identifier and name. Upstream's rename to V07 changed its bundle identifier to "
        },
        {
          "insert": "dev.davis.v07",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which macOS treats as a different app. A fixed identity keeps an upstream rename from changing what macOS sees."
        }
      ],
      "children": []
    },
    "naming-upstream": {
      "id": "naming-upstream",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The source tree, Swift module names, "
        },
        {
          "insert": "README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "scripts/build-app.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keep upstream's V07 names and are identical to upstream, so a sync has no rename conflicts in them. Fork notes live in "
        },
        {
          "insert": "TRANSCRIBER.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "naming-retained": {
      "id": "naming-retained",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "These identifiers stay Sotto because stored records and running services depend on them: the archive source ID "
        },
        {
          "insert": "sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and its "
        },
        {
          "insert": "records/sotto/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " folder, the "
        },
        {
          "insert": "--sotto-data",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " flag, the launchd labels "
        },
        {
          "insert": "ai.codecaine.sotto.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ai.codecaine.sotto.archive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the repository name "
        },
        {
          "insert": "Codecaine-AI/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-product-direction-boundaries-8": {
      "id": "b-10-product-direction-boundaries-8",
      "type": "heading",
