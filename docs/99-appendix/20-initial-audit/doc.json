    "b-20-initial-audit-three-existing-wav-fil-21": {
      "id": "b-20-initial-audit-three-existing-wav-fil-21",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Three existing WAV files will be omitted.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Their sizes are 9,344,300, 8,985,388, and 8,560,172 bytes. All exceed 8,388,608 bytes. The WisprSync export contains all three files at those sizes; the available Wispr backup has the same oversized lengths. A smaller backup WAV cannot recover them under this limit."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-twenty-four-existing-r-22": {
      "id": "b-20-initial-audit-twenty-four-existing-r-22",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Twenty-four existing records have no timestamp.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " WisprSync retains them under its unknown-time structure. All 24 are already in the export, and none has a timestamp in the available backup. Sotto requires a usable date and would fail these records. These 24 exported records contain no ASR/formatted/edited/pasted text, but their metadata still belongs to the archive."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-one-live-history-row-h-23": {
      "id": "b-20-initial-audit-one-live-history-row-h-23",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "One live History row has no valid UUID.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Sotto skips such rows and reports a warning. The current export contains valid UUIDs. This is a separate source-completeness issue, not evidence that an exported transcript is missing."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-no-current-raw-transcr-24": {
      "id": "b-20-initial-audit-no-current-raw-transcr-24",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "No current raw transcript hits the 64 KiB request limit.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The largest observed raw ASR field is 5,054 bytes. The largest nonmedia source field observed is 15,534 bytes. This checks individual live fields; it does not prove every combined versioned "
        },
        {
          "insert": "source.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " will fit the limit indefinitely."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-the-existing-export-co-25": {
      "id": "b-20-initial-audit-the-existing-export-co-25",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The existing export contains no IDs absent from the live database at inspection time.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " This reduces the immediate risk of losing archive-only sessions through direct database import. It does not make importing the export redundant: its files, export metadata, and historical run records are separate information."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-the-bounded-source-archi-26": {
      "id": "b-20-initial-audit-the-bounded-source-archi-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The bounded source archive targets about 7 MiB, reserving space below the server's 8 MiB limit. Oversized values can become size/hash summaries, and older row versions can be omitted with explicit partial-provenance markers. "
        },
        {
          "insert": "builtInAudio",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " bytes are not archived by this implementation. That column is empty in the inspected live data."
        }
      ],
      "children": []
    },
