    "b-20-initial-audit-support-wisprsync-export-31": {
      "id": "b-20-initial-audit-support-wisprsync-export-31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Support WisprSync exports and live Wispr imports as distinct sources. Preserve original WisprSync metadata, indexes, manifests, run reports, and media bytes. Keep unknown dates and unusual source IDs explicitly represented. Preserve unsupported media as opaque files even when playback is unavailable. Use streaming transfer and storage for large files, with clear failure states rather than a successful-looking partial archive."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-keep-original-source-dat-32": {
      "id": "b-20-initial-audit-keep-original-source-dat-32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep original source data separate from normalized fields and derived model output. Every normalized field should identify its source record/version. Retain observed media versions by content hash. A completeness report should count records, fields, files, bytes, and omissions for each import."
        }
      ],
      "children": []
    },
    "b-20-initial-audit-make-datasets-explicit-33": {
