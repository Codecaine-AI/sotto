    "b-20-initial-audit-text-13": {
      "id": "b-20-initial-audit-text-13",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "<Sotto server data directory>/\n  generations/<Sotto UUID>/\n    metadata.json       # Sotto history record, including rawText and importedSource\n    transcript.txt      # Selected display/final transcript\n    source.json         # Typed History columns and source row versions\n    source.wav          # Available supported WAV, subject to size limit\n    opus.json           # Available Opus packet representation\n    screenshot.png      # Available supported screenshot\n  imports/wispr-flow/\n    dictionary.json\n    dictionary-versions/<SHA-256>.json\n    staging/            # Temporary imports, not completed records"
        }
      ],
      "children": []
    },
