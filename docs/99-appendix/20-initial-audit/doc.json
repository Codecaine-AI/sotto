    "b-20-initial-audit-this-is-broader-than-a-f-17": {
      "id": "b-20-initial-audit-this-is-broader-than-a-f-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is broader than a fixed field whitelist: the current live History table has 63 columns, and the reader attempts to preserve all of them. SQLite integers, reals, nulls, text, and blobs retain explicit types. Invalid UTF-8 text is stored as bytes. Nested JSON text remains the original string rather than WisprSync's parsed representation."
        }
      ],
      "children": []
    },
