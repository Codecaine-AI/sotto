    "b-20-initial-audit-sotto-pr-4-preserves-ra-4": {
      "id": "b-20-initial-audit-sotto-pr-4-preserves-ra-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sotto PR #4 preserves raw transcripts and the underlying Wispr Flow metadata for ordinary, successfully imported records. It does "
        },
        {
          "insert": "not",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " reproduce the complete WisprSync dataset. Three WAV files in Ford's export exceed the import limit, and 24 exported records have no timestamp and would fail to import. Dataset manifests, indexes, run history, and WisprSync-specific metadata are not imported."
        }
      ],
      "children": []
    },
