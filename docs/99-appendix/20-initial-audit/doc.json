    "b-20-initial-audit-the-pr-s-history-page-di-28": {
      "id": "b-20-initial-audit-the-pr-s-history-page-di-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR's History page displays the selected final transcript, raw ASR when different, basic date/source/status/duration information, names of stored text variants, and file-opening controls. It does not provide a full typed metadata inspector, side-by-side transcript variants, dataset management, or field-based search across the whole archive. Important data can exist in "
        },
        {
          "insert": "source.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without being visible as a usable field in History."
