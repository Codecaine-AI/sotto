    "b-readme-this-selects-the-platfor-17": {
      "id": "b-readme-this-selects-the-platfor-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This selects the platform's harness and exports the canonical default from "
        },
        {
          "insert": "build/server/sotto-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". To test a custom prompt, add "
        },
        {
          "insert": "--prompt /absolute/path/to/prompt.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the file is used exactly, including any trailing newlines. Use "
        },
        {
          "insert": "--server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when running "
        },
        {
          "insert": "test-text-engine.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "test-llama-engine.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directly against a different server build."
        }
      ],
      "children": []
    },
    "b-readme-the-suites-use-synthetic-18": {
      "id": "b-readme-the-suites-use-synthetic-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The suites use synthetic text to check corrections, numbers/negations, names, literal role markers, bounds, request isolation, and process shutdown. Portable Swift tests cover server lifecycle and output validation without model files. These checks do not establish microphone or cross-app insertion behavior."
        }
      ],
      "children": []
    }
  }
