        {
          "insert": "install.py",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/archive/install.py"
            }
          }
        },
        {
          "insert": " derives the repository root from its own location. It writes "
        },
        {
          "insert": ".local/archive-config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the "
        },
        {
          "insert": "ai.codecaine.sotto.archive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plist under "
        },
        {
          "insert": ".local",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then restarts that service for the current login session. It also writes "
        },
        {
          "insert": ".local/Start Transcriber.command",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which starts both services and opens "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It does not install a login item."
