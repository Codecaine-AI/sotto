    "b-10-native-app-and-server-the-data-page-embeds-a-n-3": {
      "id": "b-10-native-app-and-server-the-data-page-embeds-a-n-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The Data page embeds a nonpersistent WKWebView and opens the loopback archive viewer. This keeps dataset browsing independent of inference. "
        },
        {
          "insert": "TranscriptDataPage.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/Sotto/Views/TranscriptDataPage.swift"
            }
          }
        },
        {
          "insert": " owns navigation restrictions and offline recovery."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-sottowindowview-swift-4": {
      "id": "b-10-native-app-and-server-sottowindowview-swift-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "SottoWindowView.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/Sotto/Views/SottoWindowView.swift"
            }
          }
        },
        {
          "insert": " adds Data navigation. "
        },
        {
          "insert": "HistoryPage.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/Sotto/Views/HistoryPage.swift"
            }
          }
        },
        {
          "insert": " routes full history migration to the archive rather than the limited legacy importer."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-generationservice-swift-5": {
      "id": "b-10-native-app-and-server-generationservice-swift-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "GenerationService.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/SottoServerKit/GenerationService.swift"
            }
          }
        },
        {
          "insert": " writes raw.txt and clean.txt before terminal metadata and allows downloading them. Metadata is the worker's publication marker."
        }
      ],
      "children": []
    },
