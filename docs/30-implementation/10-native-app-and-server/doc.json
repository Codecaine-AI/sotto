    "b-10-native-app-and-server-the-app-is-installed-sep-7": {
      "id": "b-10-native-app-and-server-the-app-is-installed-sep-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The app is installed separately under "
        },
        {
          "insert": "/Applications/Sotto.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; moving the checkout requires updating server/helper paths and launchers, not moving the installed app. Build caches containing the original checkout path were preserved in .local/relocation-backup/build-cache. Fresh build directories prevent stale absolute paths on future builds; the next full native build may take longer."
        }
      ],
      "children": []
