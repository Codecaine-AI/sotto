    "b-10-native-app-and-server-the-native-client-and-se-1": {
      "id": "b-10-native-app-and-server-the-native-client-and-se-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The native client and the packaged server realize the "
        },
        {
          "insert": "Architecture",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-architecture"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "HTTP API",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-http-api"
            }
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "Sources/V07",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Server/src",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The directory and module names are upstream's."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-decisions-2": {
      "id": "b-10-native-app-and-server-decisions-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Decisions"
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-the-data-page-embeds-a-n-3": {
      "id": "b-10-native-app-and-server-the-data-page-embeds-a-n-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The Data page embeds a nonpersistent WKWebView and opens the loopback archive viewer. This keeps dataset browsing independent of inference. "
        },
        {
          "insert": "TranscriptDataPage.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/V07/Views/TranscriptDataPage.swift"
            }
          }
        },
        {
          "insert": " owns navigation restrictions and offline recovery."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-sottowindowview-swift-4": {
      "id": "b-10-native-app-and-server-sottowindowview-swift-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "V07WindowView.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/V07/Views/V07WindowView.swift"
            }
          }
        },
        {
          "insert": " adds Data navigation. "
        },
        {
          "insert": "HistoryPage.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/V07/Views/HistoryPage.swift"
            }
          }
        },
        {
          "insert": " links to the full transcript archive, and no control opens the limited legacy import sheet."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-generationservice-swift-5": {
      "id": "b-10-native-app-and-server-generationservice-swift-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "generation-service.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Server/src/generation-service.ts"
            }
          }
        },
        {
          "insert": " writes raw.txt and clean.txt before terminal metadata and allows downloading them. Metadata is the worker's publication marker. The reference Swift server in "
        },
        {
          "insert": "GenerationService.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/V07ServerKit/GenerationService.swift"
            }
          }
        },
        {
          "insert": " also writes both files."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-generationservicetests-6": {
      "id": "b-10-native-app-and-server-generationservicetests-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The repository has no "
        },
        {
          "insert": "Tests",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory, and "
        },
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " prohibits automated tests. Check raw and clean artifacts by dictating through V07 Dev and reading the generation's files. The upstream import implementation in "
        },
        {
          "insert": "imports.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Server/src/imports.ts"
            }
          }
        },
        {
          "insert": " remains for compatibility."
        }
      ],
      "children": []
    },
    "impl-transcriber-installer": {
      "id": "impl-transcriber-installer",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "install-local.py",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/install-local.py"
            }
          }
        },
        {
          "insert": " runs upstream's "
        },
        {
          "insert": "build-app.sh",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/build-app.sh"
            }
          }
        },
        {
          "insert": " unchanged and copies the result to "
        },
        {
          "insert": "build/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". In the copy it renames the executable, rewrites the name and bundle identifier in "
        },
        {
          "insert": "Info.plist",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and signs with the pinned local certificate. The rename stays out of upstream's build script and source tree, so a sync has no rename conflicts there."
        }
      ],
      "children": []
    },
    "impl-transcriber-bundle-identity": {
      "id": "impl-transcriber-bundle-identity",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "V07Build.swift",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "Sources/V07Core/V07Build.swift"
            }
          }
        },
        {
          "insert": " reads the display name and bundle identifier from the running bundle and falls back to upstream's values. The settings directory and Keychain service follow the bundle. Transcriber uses "
        },
        {
          "insert": "~/Library/Application Support/Transcriber",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ai.codecaine.transcriber.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and an upstream build keeps its own."
        }
      ],
      "children": []
    },
    "impl-transcriber-fixed-labels": {
      "id": "impl-transcriber-fixed-labels",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Some fixed labels in the app window show upstream's name, such as the sidebar title V07 in V07WindowView.swift. The window title and the login toggle use the bundle's display name."
        }
      ],
      "children": []
    },
    "b-10-native-app-and-server-the-app-is-installed-sep-7": {
      "id": "b-10-native-app-and-server-the-app-is-installed-sep-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The installer's target is "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Moving the checkout requires updating server and helper paths and launchers, not moving the installed app. Build caches that contain the first checkout path are kept in "
        },
        {
          "insert": ".local/relocation-backup/build-cache",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    }
  }
