    "b-10-local-setup-this-guide-describes-the-1": {
      "id": "b-10-local-setup-this-guide-describes-the-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide describes the Codecaine installation on Ford's Mac. The installed client is "
        },
        {
          "insert": "/Applications/Sotto.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", built before the fork adopted the Transcriber identity. The repository's installer installs the client as "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and that install has not been run. "
        },
        {
          "insert": "Current Status",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "00-foundation/20-current-status"
            }
          }
        },
        {
          "insert": " lists the cutover steps."
        }
      ],
      "children": []
    },
