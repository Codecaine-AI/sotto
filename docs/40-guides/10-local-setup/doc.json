    "b-10-local-setup-open-start-sotto-comma-3": {
      "id": "b-10-local-setup-open-start-sotto-comma-3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Open "
        },
        {
          "insert": ".local/Start Sotto.command",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the repository. It starts the dictation server and the archive worker and opens "
        },
        {
          "insert": "/Applications/Sotto.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". After the Transcriber install, use "
        },
        {
          "insert": ".local/Start Transcriber.command",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-local-setup-choose-data-in-sotto-4": {
      "id": "b-10-local-setup-choose-data-in-sotto-4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Choose "
        },
        {
          "insert": "Data",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " in the app to browse the shared transcript archive."
        }
      ],
      "children": []
    },
    "b-10-local-setup-for-dictation-open-di-5": {
      "id": "b-10-local-setup-for-dictation-open-di-5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For dictation, open "
        },
        {
          "insert": "Dictation",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", allow Microphone and Accessibility in macOS, focus a text field, hold the configured key, speak, and release. "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " shows the current key."
        }
      ],
      "children": []
    },
    "b-10-local-setup-the-updated-app-may-need-6": {
      "id": "b-10-local-setup-the-updated-app-may-need-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For client changes, run "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the repository root. It installs Transcriber and leaves Sotto.app in place. The "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " guide covers one-time certificate setup, how signing preserves permissions, recovery for stale Accessibility entries, and verification commands. The signing configuration exists on this Mac at "
        },
        {
          "insert": "~/.config/transcriber/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
