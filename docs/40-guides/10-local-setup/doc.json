    "b-10-local-setup-the-updated-app-may-need-6": {
      "id": "b-10-local-setup-the-updated-app-may-need-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For client changes, run "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the repository root. The "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " guide covers one-time certificate setup, how signing preserves permissions, recovery for stale Accessibility entries, and verification commands. The local certificate is already configured on this Mac."
        }
      ],
      "children": []
    },
