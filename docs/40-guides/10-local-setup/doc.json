    "b-10-local-setup-six-archive-tests-and-fo-24": {
      "id": "b-10-local-setup-six-archive-tests-and-fo-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The results in this section predate the 2026-09-30 sync. Six archive tests and fourteen focused server tests passed. Two real-audio recordings passed recognition, cleanup, raw/clean file equality, repeat-import checks, and archive integrity verification. Upstream PR #23 removed the Swift and server tests."
        }
      ],
      "children": []
    },
    "local-signing-validation-scope": {
      "id": "local-signing-validation-scope",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The changed-build test on the installed Sotto client retained the same certificate-based signing requirement, Microphone and Accessibility grants, and an active hotkey listener. The user confirmed dictation worked after that rebuild. Transcriber has a different bundle identifier, so macOS treats it as a new app. Its permissions and dictation have not been tested. A full macOS reboot has not been tested. Preserve the local certificate for future rebuilds."
        }
      ],
      "children": []
    },
