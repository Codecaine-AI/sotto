      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The installed app, dictation server, and archive worker start at login through the configured LaunchAgents. Quitting Sotto leaves the server and archive worker running."
        }
      ],
      "children": []
    },
    "b-10-local-setup-wispr-history-was-migrat-21": {
      "id": "b-10-local-setup-wispr-history-was-migrat-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wispr Flow is quit and removed from login startup. Its nightly WisprSync job is disabled. A final import and integrity check preserved the available history and dictionary entries. The app and source data remain installed. Only new Sotto data is monitored automatically."
        }
      ],
      "children": []
